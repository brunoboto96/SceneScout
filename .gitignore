node_modules
dist/
.scenescout/
# Run output under the tool's former names. The engine still migrates a
# pre-rename .scenecraft/ (memory.ts), and hygiene-test names both of these
# as directories that may never be tracked — this keeps them from ever
# being staged in the first place.
.scenecraft/
.frontend-tester/

# local scratch written by test runs
.scenescout-fixtures/
.tmp-fixtures/
*.tgz

# ── never commit these ───────────────────────────────────────────────────────
# Secrets and local configuration
.env
.env.*
.npmrc
*.pem
*.p12
*.pfx
*.key

# Saved logins. A Playwright storage state holds live session cookies for
# whatever app it was recorded against.
playwright/.auth/
*.har
trace.zip
test-results/
playwright-report/
**/*storage-state*.json
**/*storageState*.json

# Editors, operating systems, logs, coverage
.DS_Store
Thumbs.db
.idea/
.vscode/
# Agent scratch: worktrees and local settings an AI coding tool keeps beside the checkout.
.claude/
*.swp
*.log
npm-debug.log*
coverage/
